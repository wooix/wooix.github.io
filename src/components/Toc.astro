---
import TocBranch from './TocBranch.astro';
import { buildToc, type Heading } from '../lib/toc';
export type { Heading } from '../lib/toc';
interface Props { headings: Heading[]; }
const { headings } = Astro.props;
---
<nav aria-label="이 페이지의 목차" class="toc-nav">
  <p class="toc-title">이 페이지에서</p>
  <TocBranch nodes={buildToc(headings)} />
</nav>
