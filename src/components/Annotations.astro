---
import '../styles/annotations.css';
---
<details class="annotation-tools" data-pagefind-ignore>
  <summary>내 메모 · 백업</summary>
  <p>문단 사이의 ＋로 메모를 넣으세요. 문장 선택 후 오른쪽 클릭으로 밑줄·형광펜을 사용할 수 있습니다. 기록은 이 브라우저에만 저장됩니다.</p>
  <button id="annotation-export">이 글 백업</button>
  <label>백업 가져오기 <input id="annotation-import" type="file" accept="application/json,.json" /></label>
  <p id="annotation-status" role="status"></p>
  <div id="annotation-orphans"></div>
</details>
<div id="annotation-menu" class="annotation-menu" role="dialog" aria-label="문장 표시" data-pagefind-ignore hidden>
  <div class="annotation-colors" role="group" aria-label="표시 색상">
    {['노랑', '초록', '파랑', '분홍', '보라'].map((name, i) => <button data-color={i} aria-label={name} aria-pressed={i === 0} style={`--swatch:var(--annotation-${i})`}></button>)}
  </div>
  <button data-mark="underline">밑줄</button><button data-mark="highlight">형광펜</button>
  <button id="annotation-remove-mark">이 표시 지우기</button>
  <button id="annotation-insert">이 문단 아래 메모</button>
  <button id="annotation-menu-close">닫기</button>
</div>
<script src="../scripts/annotations.ts"></script>
