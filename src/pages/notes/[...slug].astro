---
import { render } from 'astro:content';
import '../../styles/heading-subtitles.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Annotations from '../../components/Annotations.astro';
import PostRow from '../../components/PostRow.astro';
import { getPosts, noteUrl, formatDate } from '../../lib/posts';
import { getTopic, kindLabels } from '../../data/topics';
export async function getStaticPaths() { return (await getPosts()).map((post) => ({ params: { slug: post.id }, props: { post } })); }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const topic = getTopic(post.data.topic);
const posts = await getPosts();
const parent = post.data.parentPost ? posts.find((entry) => entry.id === post.data.parentPost) : undefined;
if (post.data.parentPost && !parent) throw new Error(`Missing published parent for ${post.id}: ${post.data.parentPost}`);
const index = posts.findIndex((entry) => entry.id === post.id);
const previous = posts[index + 1];
const next = posts[index - 1];
const related = posts.filter((entry) => entry.id !== post.id).sort((a, b) => Number(b.data.topic === post.data.topic) - Number(a.data.topic === post.data.topic) || b.data.tags.filter((tag) => post.data.tags.includes(tag)).length - a.data.tags.filter((tag) => post.data.tags.includes(tag)).length).slice(0, 2);
const allHeadings = [{ depth: 2, slug: 'key-takeaway', text: '핵심 요약' }, ...headings.filter((h) => h.depth >= 2 && h.depth <= 6), { depth: 2, slug: 'sources', text: '원문과 참고 자료' }, { depth: 2, slug: 'related', text: '함께 읽을 노트' }];
const jsonLd = { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.data.title, description: post.data.description, datePublished: post.data.publishedAt.toISOString(), dateModified: (post.data.updatedAt || post.data.publishedAt).toISOString(), author: { '@type': 'Person', name: 'wooix', url: new URL('/about/', Astro.site).href }, url: new URL(noteUrl(post), Astro.site).href, inLanguage: 'ko-KR' };
---
<BaseLayout title={post.data.title} description={post.data.description} activeTopic={topic.id} headings={allHeadings} article studyMinutes={post.data.readingTime}>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  <nav class="breadcrumb" aria-label="현재 위치"><a href="/">연구 노트</a><span>/</span><a href={`/topics/${topic.id}/`}>{topic.label}</a><span>/</span>{parent && <><a href={noteUrl(parent)}>{parent.data.navLabel || parent.data.title}</a><span>/</span></>}<span>{parent ? (post.data.navLabel || '논문 해설') : '노트'}</span></nav>
  <article data-pagefind-body>
    <header class="article-header"><div class="article-kicker"><a href={`/topics/${topic.id}/`} data-pagefind-filter="topic">{topic.label}</a><span>·</span><span>{kindLabels[post.data.kind]}</span></div><h1 data-pagefind-meta="title">{post.data.title}</h1><p class="article-description" data-pagefind-meta="description">{post.data.description}</p><div class="article-meta" data-pagefind-ignore><span class="author-avatar">w</span><strong>wooix</strong><span>·</span><time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time><span>·</span><span class="reading-time"><Icon name="clock" size={14} />{post.data.readingTime}분 읽기</span>{post.data.updatedAt && <span class="updated-date">수정 {formatDate(post.data.updatedAt)}</span>}</div><div class="tag-list" data-pagefind-ignore>{post.data.tags.map((tag) => <span>{tag}</span>)}</div></header>
    <section id="key-takeaway" class="takeaway-box"><div class="takeaway-label"><Icon name="spark" size={16} /><h2>핵심 요약</h2></div><p>{post.data.takeaway}</p></section>
    <div class="prose"><Content /></div>
    <section id="sources" class="sources-section"><div class="section-heading"><h2>원문과 참고 자료</h2><span class="small-label">PRIMARY SOURCES</span></div><ol>{post.data.sourceLinks.map((source, i) => <li><span class="source-number">{String(i + 1).padStart(2, '0')}</span><div><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}<Icon name="external" size={13} /></a><span>{source.kind || new URL(source.url).hostname}</span></div></li>)}</ol></section>
  </article>
  <Annotations />
  <div class="article-endnote"><Icon name="book" size={19} /><p>이 노트는 원문을 읽고 재구성한 개인 연구 기록입니다.<br/>논문의 주장과 해석을 구분하며, 새로운 근거를 만나면 업데이트합니다.</p></div>
  <section id="related" class="related-section"><div class="section-heading"><h2>함께 읽을 노트</h2></div>{related.map((entry) => <PostRow post={entry} />)}</section>
  <nav class="post-pagination" aria-label="이전 및 다음 글">{previous ? <a href={noteUrl(previous)}><span>← 이전 노트</span><strong>{previous.data.title}</strong></a> : <div></div>}{next ? <a class="next" href={noteUrl(next)}><span>다음 노트 →</span><strong>{next.data.title}</strong></a> : <div></div>}</nav>
</BaseLayout>
