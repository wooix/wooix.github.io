---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from '../components/PostRow.astro';
import Icon from '../components/Icon.astro';
import { getPosts, noteUrl } from '../lib/posts';
import { topics, getTopic, kindLabels } from '../data/topics';
const posts = await getPosts();
const featured = posts.find((post) => post.data.featured) || posts[0];
const headings = [{ depth: 2, slug: 'start-here', text: '이곳에서 읽는 것' }, { depth: 2, slug: 'featured', text: '먼저 읽어볼 노트' }, { depth: 2, slug: 'recent-notes', text: '새로 기록한 노트' }, { depth: 2, slug: 'research-map', text: '관심 분야 지도' }];
---
<BaseLayout title="연구 노트" headings={headings}>
  <div class="breadcrumb"><span>연구 노트</span><span>/</span><span>Overview</span></div>
  <header class="home-intro" id="start-here"><p class="eyebrow"><span></span>A PERSONAL RESEARCH JOURNAL</p><h1>AI의 흐름을 읽고,<br/>연구의 맥락을 잇습니다<span class="orange-dot">.</span></h1><p class="intro-description">새로운 논문에서 오래 남을 아이디어를 찾습니다.<br class="desktop-break"/>언어 모델의 원리부터 작은 모델의 실제 구동까지,<br class="desktop-break"/>이해한 만큼 차근차근 기록하는 개인 연구 노트입니다.</p><div class="intro-meta"><span class="author-avatar">w</span><span>기록하는 사람 <strong>wooix</strong></span><span class="meta-separator">/</span><span>{topics.length}개 연구 분야</span><span class="meta-separator">/</span><span>{posts.length}편의 노트</span></div></header>
  <div class="reading-principle"><span class="principle-icon"><Icon name="book" size={18} /></span><p><strong>영어로 익히고, 한국어로 이해합니다.</strong><br/><span>핵심 용어는 <b>Alignment(정렬)</b>처럼 반복 병기합니다.</span></p><a href="/about/#language-policy" aria-label="용어 표기 원칙 보기"><Icon name="arrow" size={18} /></a></div>
  <section class="home-section" id="featured"><div class="section-heading"><h2>먼저 읽어볼 노트</h2><span class="small-label">EDITOR'S PICK</span></div>{featured && <article class="featured-note"><div class="featured-topline"><span class="featured-label"><Icon name="spark" size={14} />출발점이 되는 논문</span><span>{getTopic(featured.data.topic).label}</span></div><h3><a href={noteUrl(featured)}>{featured.data.title}</a></h3><p>{featured.data.description}</p><div class="featured-bottom"><span>{kindLabels[featured.data.kind]}<span class="dot-divider">·</span>{featured.data.readingTime}분 읽기</span><a href={noteUrl(featured)}>노트 읽기<Icon name="arrow" size={17} /></a></div><div class="feature-art" aria-hidden="true"><span></span><span></span><span></span></div></article>}</section>
  <section class="home-section" id="recent-notes"><div class="section-heading"><h2>새로 기록한 노트 <span class="section-count">{posts.length.toString().padStart(2, '0')}</span></h2><a class="subtle-link" href="/archive/">전체 보기<Icon name="arrow" size={14} /></a></div><div class="post-list">{posts.slice(0, 4).map((post, index) => <PostRow post={post} index={index} />)}</div><p class="list-footnote">기록일 기준으로 정렬합니다. 원논문의 발표 연도는 각 노트에서 확인할 수 있습니다.</p></section>
  <section class="home-section research-map" id="research-map"><div class="section-heading"><h2>관심 분야 지도</h2><span class="small-label">CONNECTED IDEAS</span></div><p class="section-description">하나의 질문에서 다음 질문으로, 관심의 지도를 넓혀갑니다.</p><div class="topic-grid">{topics.map((topic, index) => <a href={`/topics/${topic.id}/`} class="topic-tile"><span class="topic-index">0{index + 1}</span><div><h3>{topic.label}</h3><p>{topic.english}</p></div><Icon name="arrow" size={15} /></a>)}</div></section>
</BaseLayout>
